# Copy this file to `.env` and fill in values. Never commit `.env`.

# Groq LLM (OpenAI-compatible). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional aliases also accepted: LLM_API_KEY=

# Defaults target Groq; override if needed
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional aliases: LLM_MODEL=  LLM_BASE_URL=

LLM_PROVIDER=groq
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Set true to skip live LLM calls during local UI/dev work
LLM_MOCK_MODE=false

# Recommendation defaults (Phase 7)
DEFAULT_TOP_K=5
CANDIDATE_CAP=50
# HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# --- API ---
# Local default binds loopback. For Docker / VPS / PaaS use 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000
# PaaS platforms often inject PORT; settings accept PORT as an alias of API_PORT.

# Comma-separated browser origins (exact). Avoid * with credentialed CORS.
# Local Next.js:
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# API_CORS_ORIGINS=https://your-frontend.example.com

API_RATE_LIMIT_PER_MINUTE=60
# Set true in public deploys to hide /docs, /redoc, /openapi.json
API_DISABLE_DOCS=false

# Docker Compose only: run Hugging Face ingestion when processed Parquet is missing
# RUN_INGESTION=false
